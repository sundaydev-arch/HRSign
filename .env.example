# ===== Database =====
DATABASE_URL="postgresql://hrsign:hrsign_dev_123@localhost:5433/hrsign?schema=public"

# ===== MinIO =====
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=hrsign

# ===== NextAuth =====
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Next.js loads env from apps/web only. After copying this file to repo-root `.env`:
#   ln -sf ../../.env apps/web/.env

# ===== App =====
APP_URL=http://localhost:3000
WATERMARK_TEXT=HRSign INTERNAL

# Envelope API backend for the browser UI (leave empty = Next same-origin /api/v1).
# Python / Go are standalone — they do NOT call Next.
# NEXT_PUBLIC_API_BASE=http://localhost:8000/v1
# NEXT_PUBLIC_API_BASE=http://localhost:8080/v1

# ===== Crypto demos (optional; admin Settings can also upload PEM) =====
# PADES_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# PADES_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GM_SM2_PRIVATE_KEY=

# ===== IM bot webhooks (optional notify channels) =====
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=
# LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://....webhook.office.com/webhookb2/...

# ===== Email (if SMTP is unset, notifications are marked SKIPPED and do not block the flow) =====
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HRSign <hrsign@example.com>"

# ===== SMS (Phase 2 — default provider=log writes to console + notification_logs) =====
# SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ===== OIDC SSO (optional; leave blank to hide SSO button) =====
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ===== Worker (optional; defaults to DATABASE_URL) =====
# DATABASE_URL_WORKER=

# ===== Observability / multi-instance =====
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
# DATABASE_URL_WORKER=
