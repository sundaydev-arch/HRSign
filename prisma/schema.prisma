generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =================================================================
// HRSign Prisma Schema
// 规范：开源人事电子签署与盖章系统（HR e-Sign Workflow）
// 术语：企业印章 = Seal；个人签署 = Signature（不得混用）
// 所有 Json 列在代码中配对一个 zod schema（见 src/schemas/）
// =================================================================

// ============ 用户与权限（spec 6 / 20.5）============

enum UserRole {
  SUPER_ADMIN   // 超级管理员
  HR            // 人事
  DEPT_LEADER   // 部门负责人
  EMPLOYEE      // 普通员工
}

// spec 20：User 显示设置
enum UserLocale {
  zh_CN
  en
}

enum UserTimeFormat {
  H12
  H24
}

enum UserWeekStart {
  SUNDAY
  MONDAY
}

enum UserDensity {
  COMPACT     // 紧凑（表格页默认）
  COMFORTABLE // 舒适（默认）
}

enum UserTheme {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  // spec 20.5：姓名以 fullName 单字段为主
  fullName      String
  givenName     String?
  familyName    String?
  legalNameLatin String?
  // 账号密码（辅）；OIDC 登录用户无密码
  passwordHash  String?
  // OIDC subject（主）
  oidcSubject   String?         @unique
  role          UserRole        @default(EMPLOYEE)
  isActive      Boolean         @default(true)

  // spec 20：显示设置
  locale        UserLocale      @default(zh_CN)
  timezone      String          @default("Asia/Shanghai")
  timeFormat    UserTimeFormat  @default(H24)
  weekStart     UserWeekStart   @default(MONDAY)
  density       UserDensity     @default(COMFORTABLE)
  theme         UserTheme       @default(SYSTEM)

  // spec 20.5：电话 E.164 存储
  phoneE164     String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // 关系
  createdTemplates         Template[]         @relation("TemplateCreator")
  createdTemplateVersions  TemplateVersion[]  @relation("TemplateVersionCreator")
  documents                Document[]         @relation("DocumentCreator")
  documentVersions         DocumentVersion[]  @relation("DocumentVersionCreator")
  signingTasks             SigningTask[]      @relation("TaskCreator")
  signers                  Signer[]
  approvalRecords          ApprovalRecord[]
  apiKeys                  ApiKey[]
  webhooks                 Webhook[]
  auditLogs                AuditLog[]
  notificationLogsSent     NotificationLog[]  @relation("NotificationRecipient")
  seals                    Seal[]             @relation("SealCreator")
  signatures               Signature[]        @relation("SignatureOperator")

  @@map("users")
}

// spec 6：权限矩阵"角色 × 动作 × 资源"
// Permission 表登记所有 (action, resource) 组合
// RolePermission 表存储角色与权限的对应（可由管理员维护）
// 实际 authorize(user, action, resource) 在代码中实现并有单测（spec 16）

model Permission {
  id            String           @id @default(cuid())
  action        String           // e.g. "template.create", "document.read"
  resource      String           // e.g. "template", "document"
  description   String?
  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleName      UserRole
  permissionId  String
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleName, permissionId])
  @@map("role_permissions")
}

// ============ 模板（spec 3.1：发布后不可变）============

enum TemplateCategory {
  OFFER        // offer
  ENTRY        // 入职证明
  CONTRACT     // 劳动合同
  RESIGN       // 离职证明
  CERTIFICATE  // 在职/收入证明
}

// spec 20.2：Template 增加 locale 字段
enum TemplateLocale {
  zh_CN
  en
  BILINGUAL
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Template {
  id        String           @id @default(cuid())
  name      String
  category  TemplateCategory
  locale    TemplateLocale   @default(zh_CN)
  createdBy String
  creator   User             @relation("TemplateCreator", fields: [createdBy], references: [id])
  versions  TemplateVersion[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("templates")
}

model TemplateVersion {
  id          String                @id @default(cuid())
  templateId  String
  template    Template              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  status      TemplateVersionStatus @default(DRAFT)
  // 模板原 PDF 的 storageKey（spec 3.1：发布后不可变）
  storageKey  String                @unique
  sha256      String
  pageCount   Int
  // spec 5：水印配置（Json，由 zod 校验）
  watermarkConfig Json?
  fields      TemplateField[]
  documents   Document[]
  createdBy   String
  creator     User                  @relation("TemplateVersionCreator", fields: [createdBy], references: [id])
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([templateId, version])
  @@index([templateId])
  @@map("template_versions")
}

// spec 3.1：字段类型
enum FieldType {
  TEXT
  DATE
  SEAL              // 企业签章域
  SIGNATURE         // 个人签名域
  PERFORATION_SEAL  // 骑缝章（spec 20.6 预留，阶段1不实现）
}

model TemplateField {
  id                String          @id @default(cuid())
  templateVersionId String
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  type              FieldType
  label             String
  // spec 3.1：坐标结构 { page, x, y, width, height, rotation } 存 Json 列
  // 单位 PDF point，原点左下角；PERFORATION_SEAL 可表达跨页
  // 读写必须经过 zod schema（src/schemas/coordinates.ts）
  coordinates       Json
  required          Boolean         @default(false)
  defaultValue      String?
  // spec 3.1：校验规则存 Json 列，读写经 zod
  validationRules   Json?
  // spec 5：字体配置
  fontSize          Int             @default(12)
  fontFamily        String?
  // spec 20.2：多语言标签（Json，键为 locale）
  labelI18n         Json?
  sortOrder         Int             @default(0)

  signatures        Signature[]

  @@index([templateVersionId])
  @@map("template_fields")
}

// ============ 印章（spec 0/4：Seal = 企业印章）============

enum SealStyle {
  ROUND_CHINESE        // 圆形公章（国内）
  TEXT_INTERNATIONAL   // 文字公司章（国际）
  NONE                 // 不盖章（spec 20.6：由模板字段决定，不写死）
}

model Seal {
  id         String    @id @default(cuid())
  name       String
  style      SealStyle @default(ROUND_CHINESE)
  // spec 12：公章原图仅后端读取，不下发前端
  storageKey String    @unique
  sha256     String
  // 尺寸（PDF point）
  width      Float
  height     Float
  enabled    Boolean   @default(true)
  createdBy  String
  creator    User      @relation("SealCreator", fields: [createdBy], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  signatures Signature[]

  @@map("seals")
}

// ============ 文档与版本（spec 3.2：多版本留存不覆盖）============

enum DocumentVersionStage {
  FILLED       // 表单数据填充
  WATERMARKED  // 加水印
  SEALED       // 企业盖章
  SIGNED       // 个人签名（含阶段2加密签名）
}

model Document {
  id                String           @id @default(cuid())
  templateVersionId String
  templateVersion   TemplateVersion  @relation(fields: [templateVersionId], references: [id])
  title             String
  category          TemplateCategory
  // 业务字段值（用于生成 PDF 的填充数据），由 zod schema 校验
  fieldValues       Json?
  createdBy         String
  creator           User             @relation("DocumentCreator", fields: [createdBy], references: [id])
  versions          DocumentVersion[]
  signingTask       SigningTask?
  // spec 9：法务冻结
  legalHold         Boolean          @default(false)
  legalHoldReason   String?
  legalHoldUntil    DateTime?
  // spec 9：到期由 retention-scan 软删除
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([templateVersionId])
  @@map("documents")
}

model DocumentVersion {
  id          String                @id @default(cuid())
  documentId  String
  document    Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  stage       DocumentVersionStage
  // spec 2：StorageProvider key 含版本号，禁止覆盖写
  // 形如 documents/{docId}/v{version}-{stage}.pdf
  storageKey  String                @unique
  sha256      String
  createdBy   String
  creator     User                  @relation("DocumentVersionCreator", fields: [createdBy], references: [id])
  // spec 3.2：加密签名后只读锁定（阶段2 才会真正锁定，阶段1 仅记录字段）
  lockedAt    DateTime?
  createdAt   DateTime              @default(now())

  signatures  Signature[]

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

// ============ 签署任务（spec 3.3：两个独立状态机）============

enum SigningFlowType {
  SEQUENTIAL  // 顺序签
  PARALLEL    // 并行签
}

// 状态机1：ApprovalStatus
enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

// 状态机2：SigningStatus
enum SigningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DECLINED
  EXPIRED
  REVOKED
}

enum SignerStatus {
  PENDING
  VIEWED
  SIGNED
  DECLINED
}

enum SignerRole {
  APPROVER            // 审批人
  COMPANY_SEAL        // 企业盖章签署人
  PERSONAL_SIGNATURE  // 个人签署人
}

model SigningTask {
  id              String        @id @default(cuid())
  documentId      String        @unique
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title           String
  flowType        SigningFlowType @default(SEQUENTIAL)

  // spec 3.3：两个独立状态机
  approvalStatus  ApprovalStatus @default(DRAFT)
  signingStatus   SigningStatus  @default(NOT_STARTED)

  expiresAt       DateTime?
  revokedReason   String?
  revokedAt       DateTime?

  createdBy       String
  creator         User          @relation("TaskCreator", fields: [createdBy], references: [id])

  signers         Signer[]
  approvalFlow    ApprovalFlow?
  approvalRecords ApprovalRecord[]
  signatures      Signature[]
  notifications   NotificationLog[]
  webhookDeliveries WebhookDelivery[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([approvalStatus])
  @@index([signingStatus])
  @@map("signing_tasks")
}

model Signer {
  id                String       @id @default(cuid())
  taskId            String
  task              SigningTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // 内部签署人（spec 6：HR/部门负责人/员工）
  userId            String?
  user              User?        @relation(fields: [userId], references: [id])
  // 外部签署人（spec 4：无账号访问）
  externalFullName  String?
  externalEmail     String?
  externalPhoneE164 String?

  signRole          SignerRole
  order             Int          @default(1) // 顺序签的序号，从 1 开始
  status            SignerStatus @default(PENDING)

  // spec 4：外部签署令牌（只存哈希）
  signingTokens     SigningToken[]

  viewedAt          DateTime?
  signedAt          DateTime?
  declinedAt        DateTime?
  declinedReason    String?

  signatures        Signature[]

  @@index([taskId])
  @@map("signers")
}

// spec 4：SigningToken 只存哈希，不存明文；带过期时间、可撤销
model SigningToken {
  id               String   @id @default(cuid())
  signerId         String
  signer           Signer   @relation(fields: [signerId], references: [id], onDelete: Cascade)
  // 只存哈希 sha256(plaintext)，不存明文
  tokenHash        String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  usedAt           DateTime?
  // spec 4：全程记录 IP、UA
  issuedIp          String?
  issuedUserAgent   String?

  createdAt         DateTime @default(now())

  @@index([signerId])
  @@map("signing_tokens")
}

// ============ 审批流（spec 15：ApprovalFlow + ApprovalRecord）============

model ApprovalFlow {
  id                  String       @id @default(cuid())
  taskId              String       @unique
  task                SigningTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // 审批人 ID 列表（按顺序）；具体审批人也在 Signer 表中 signRole=APPROVER
  approverIds         String[]
  currentApproverIndex Int         @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("approval_flows")
}

model ApprovalRecord {
  id         String         @id @default(cuid())
  taskId     String
  task       SigningTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  approverId String
  approver   User           @relation(fields: [approverId], references: [id])
  // 动作：APPROVE / REJECT / WITHDRAW
  action     String
  fromStatus ApprovalStatus
  toStatus   ApprovalStatus
  comment    String?
  ip         String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([taskId])
  @@map("approval_records")
}

// ============ 签名记录（spec 0：Signature = 个人签署）============

enum SignatureMethod {
  IMAGE_SEAL   // 阶段1：图片印章
  HANDWRITE    // 阶段1：手写签名图片
  // 阶段2 预留（仅枚举值，不在阶段1 实现）
  PADES
  GM_SM2
}

model Signature {
  id                String           @id @default(cuid())
  taskId            String
  task              SigningTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  signerId          String
  signer            Signer           @relation(fields: [signerId], references: [id])
  // 操作人（外部签署人无账号）
  operatorId        String?
  operator          User?            @relation("SignatureOperator", fields: [operatorId], references: [id])

  method            SignatureMethod
  // 阶段1：签名图 storageKey；阶段2：签名数据
  storageKey        String?
  sealId            String?
  seal              Seal?            @relation(fields: [sealId], references: [id])

  // 填充到哪个模板域
  fieldId           String?
  field             TemplateField?   @relation(fields: [fieldId], references: [id])

  // spec 3.2：每次盖章/签名产生新 DocumentVersion
  documentVersionId String?
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id])

  // spec 2：SignatureProvider.verify 的结果（Json，由 zod 校验）
  verificationResult Json?

  ip                String?
  userAgent         String?
  createdAt         DateTime         @default(now())

  @@index([taskId])
  @@index([signerId])
  @@map("signatures")
}

// ============ 审计日志（spec 8：哈希链 + 只追加）============
// 数据库层禁止 UPDATE/DELETE（由迁移 SQL 中触发器强制）
// 哈希：hash = sha256(prevHash + 规范化 JSON(canonical_fields))
// spec 20.8：存"动作码 + 参数"，不存本地化文本

model AuditLog {
  id              String   @id @default(cuid())
  // 哈希链：上一条记录的 hash；首条为 null
  prevHash        String?
  // 本条记录的 hash = sha256(prevHash + canonical_json)
  hash            String   @unique
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  // 动作码（如 "task.sign"、"template.publish"）
  action          String
  targetType      String
  targetId        String?
  // 结果：success / failure
  result          String   @default("success")
  // spec 8：相关文档 sha256
  documentSha256  String?
  ip              String?
  userAgent       String?
  // 动作参数（Json，由 zod schema 校验，不存本地化文本）
  detail          Json?
  createdAt       DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============ 数据保留（spec 9）============

enum RetentionAction {
  SOFT_DELETE
  HARD_DELETE
  NOTIFY_OWNER
}

model RetentionPolicy {
  id              String           @id @default(cuid())
  name            String
  category        TemplateCategory
  // 保留年限
  retentionYears  Int
  action          RetentionAction  @default(SOFT_DELETE)
  enabled         Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // 每个分类只有一条策略
  @@unique([category])
  @@map("retention_policies")
}

// ============ API Key & Webhook（spec 10）============

model ApiKey {
  id                String    @id @default(cuid())
  name              String
  // spec 12：只存哈希
  keyHash           String    @unique
  // 用于识别（前 8 字符明文）
  keyPrefix         String
  createdBy         String
  creator           User      @relation(fields: [createdBy], references: [id])
  // 权限范围
  scopes            String[]  @default([])
  rateLimitPerMinute Int?
  lastUsedAt        DateTime?
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@map("api_keys")
}

model Webhook {
  id          String             @id @default(cuid())
  name        String
  url         String
  // HMAC 签名密钥（只存哈希）
  secretHash  String
  // 用于识别
  secretPrefix String
  // 订阅事件（如 task.created, approval.result, signing.completed）
  events      String[]           @default([])
  enabled     Boolean            @default(true)
  createdBy   String
  creator     User               @relation(fields: [createdBy], references: [id])
  deliveries  WebhookDelivery[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("webhooks")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

model WebhookDelivery {
  id             String               @id @default(cuid())
  webhookId      String
  webhook        Webhook              @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  taskId         String?
  task           SigningTask?         @relation(fields: [taskId], references: [id])
  event          String
  // payload 由 zod schema 校验
  payload        Json
  // HMAC 签名（用于发送）
  signature      String
  responseStatus Int?
  responseError  String?
  attemptCount   Int                  @default(0)
  status         WebhookDeliveryStatus @default(PENDING)
  deliveredAt    DateTime?
  nextRetryAt    DateTime?
  createdAt      DateTime             @default(now())

  @@index([webhookId])
  @@map("webhook_deliveries")
}

// ============ 通知（spec 2 Notifier / 20：模板按 locale 多份）============

enum NotificationChannel {
  EMAIL     // 阶段1 必实现
  WECOM     // 企业微信（可选适配器）
  DINGTALK  // 钉钉（可选适配器）
  LARK      // 飞书（可选适配器）
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // 渠道未配置
}

model NotificationLog {
  id               String             @id @default(cuid())
  taskId           String?
  task             SigningTask?       @relation(fields: [taskId], references: [id])
  // 接收人
  recipientUserId  String?
  recipientUser    User?              @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  recipientEmail   String?
  recipientPhone   String?
  channel          NotificationChannel @default(EMAIL)
  // spec 20：模板按 locale 多份，这里只引用 key
  templateKey      String
  // 模板参数（Json，ICU MessageFormat 变量）
  templateParams   Json?
  // 实际发送内容（用于审计）
  subject          String?
  body             String?
  status           NotificationStatus @default(PENDING)
  error            String?
  // 重试信息
  attemptCount     Int                @default(0)
  sentAt           DateTime?
  createdAt        DateTime           @default(now())

  @@index([taskId])
  @@map("notification_logs")
}

// spec 15/20：NotificationTemplate 按 locale 存多份
model NotificationTemplate {
  id            String             @id @default(cuid())
  key           String             // e.g. "signing.invitation", "approval.request"
  channel       NotificationChannel
  locale        UserLocale
  // ICU MessageFormat（spec 20.1）
  subject       String
  body          String
  defaultParams Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // 每个 (key, channel, locale) 组合唯一
  @@unique([key, channel, locale])
  @@map("notification_templates")
}

// ============ 身份验证（spec 2 IdentityVerifier / 4 邮箱验证码）============

enum IdentityVerificationType {
  EMAIL_CODE  // 阶段1 实现
  // 阶段2 预留（仅枚举值）
  FACE
  REAL_NAME
}

enum IdentityVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

model IdentityVerification {
  id                String                     @id @default(cuid())
  type              IdentityVerificationType   @default(EMAIL_CODE)
  // 验证目标（邮箱、手机号等）
  target            String
  // spec 4：验证码哈希（只存哈希）
  codeHash          String
  // spec 4：次数限制和冷却
  attemptCount      Int                        @default(0)
  maxAttempts       Int                        @default(5)
  // 关联的签署令牌（外部签署人验证）
  signingTokenId    String?
  status            IdentityVerificationStatus @default(PENDING)
  verifiedAt        DateTime?
  expiresAt         DateTime
  // spec 4：IP/UA
  requestIp         String?
  requestUserAgent  String?
  createdAt          DateTime                  @default(now())

  @@index([target])
  @@map("identity_verifications")
}
