generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =================================================================
// HRSign Prisma Schema
// Spec: open-source HR e-sign and sealing system
// Terms: company stamp = Seal; personal signing = Signature (do not mix)
// Every Json column has a paired zod schema in src/schemas/
// =================================================================

// ============ Users and permissions (spec 6 / 20.5) ============

enum UserRole {
  SUPER_ADMIN   // Super admin
  HR            // HR
  DEPT_LEADER   // Department lead
  EMPLOYEE      // Employee
}

// spec 20: user display settings
enum UserLocale {
  zh_CN
  en
}

enum UserTimeFormat {
  H12
  H24
}

enum UserWeekStart {
  SUNDAY
  MONDAY
}

enum UserDensity {
  COMPACT     // Compact (table pages default)
  COMFORTABLE // Comfortable (default)
}

enum UserTheme {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  // spec 20.5: name is stored as a single fullName field
  fullName      String
  givenName     String?
  familyName    String?
  legalNameLatin String?
  // Password auth (secondary); OIDC users have no password
  passwordHash  String?
  // OIDC subject (primary)
  oidcSubject   String?         @unique
  role          UserRole        @default(EMPLOYEE)
  isActive      Boolean         @default(true)

  // spec 20: display settings
  locale        UserLocale      @default(zh_CN)
  timezone      String          @default("Asia/Shanghai")
  timeFormat    UserTimeFormat  @default(H24)
  weekStart     UserWeekStart   @default(MONDAY)
  density       UserDensity     @default(COMFORTABLE)
  theme         UserTheme       @default(SYSTEM)

  // spec 20.5: phone stored in E.164
  phoneE164     String?

  departmentId  String?
  department    Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  createdTemplates         Template[]         @relation("TemplateCreator")
  createdTemplateVersions  TemplateVersion[]  @relation("TemplateVersionCreator")
  documents                Document[]         @relation("DocumentCreator")
  documentVersions         DocumentVersion[]  @relation("DocumentVersionCreator")
  signingTasks             SigningTask[]      @relation("TaskCreator")
  signers                  Signer[]
  approvalRecords          ApprovalRecord[]
  apiKeys                  ApiKey[]
  webhooks                 Webhook[]
  auditLogs                AuditLog[]
  notificationLogsSent     NotificationLog[]  @relation("NotificationRecipient")
  seals                    Seal[]             @relation("SealCreator")
  signatures               Signature[]        @relation("SignatureOperator")
  credentialTokens         AuthCredentialToken[]
  ledDepartments           Department[]       @relation("DepartmentLeader")
  envelopesCreated         Envelope[]         @relation("EnvelopeCreator")
  envelopeComments         EnvelopeComment[]  @relation("EnvelopeCommentAuthor")
  accountMemberships       AccountMember[]

  @@index([departmentId])
  @@map("users")
}

model Department {
  id           String   @id @default(cuid())
  name         String   @unique
  leaderUserId String?
  leader       User?    @relation("DepartmentLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  users        User[]
  policies     ApprovalPolicy[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("departments")
}

/// Reusable approval policy — injects APPROVER signers when creating a task.
model ApprovalPolicy {
  id              String            @id @default(cuid())
  name            String
  category        TemplateCategory?
  departmentId    String?
  department      Department?       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Ordered User ids used as APPROVER signers when creating a task
  approverUserIds String[]          @default([])
  required        Boolean           @default(true)
  enabled         Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([category])
  @@index([departmentId])
  @@map("approval_policies")
}

// spec 6: permission matrix "role x action x resource"
// Permission lists all (action, resource) pairs
// RolePermission maps roles to permissions (admin-maintainable)
// authorize(user, action, resource) is implemented in code with unit tests (spec 16)

model Permission {
  id            String           @id @default(cuid())
  action        String           // e.g. "template.create", "document.read"
  resource      String           // e.g. "template", "document"
  description   String?
  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleName      UserRole
  permissionId  String
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleName, permissionId])
  @@map("role_permissions")
}

// ============ Templates (spec 3.1: immutable after publish) ============

enum TemplateCategory {
  OFFER        // offer
  ENTRY        // Onboarding certificate
  CONTRACT     // Employment contract
  RESIGN       // Offboarding certificate
  CERTIFICATE  // Employment / income certificate
}

// spec 20.2: Template has a locale field
enum TemplateLocale {
  zh_CN
  en
  BILINGUAL
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Template {
  id        String           @id @default(cuid())
  name      String
  category  TemplateCategory
  locale    TemplateLocale   @default(zh_CN)
  createdBy String
  creator   User             @relation("TemplateCreator", fields: [createdBy], references: [id])
  versions  TemplateVersion[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("templates")
}

model TemplateVersion {
  id          String                @id @default(cuid())
  templateId  String
  template    Template              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  status      TemplateVersionStatus @default(DRAFT)
  // Original template PDF storageKey (spec 3.1: immutable after publish)
  storageKey  String                @unique
  sha256      String
  pageCount   Int
  // DOCUMENT = TipTap online doc; PDF_OVERLAY = uploaded PDF + field coordinates
  editorMode  TemplateEditorMode    @default(PDF_OVERLAY)
  // TipTap JSON document (DOCUMENT mode only); zod: src/schemas/document-content.ts
  contentJson Json?
  // spec 5: watermark config (Json, validated by zod)
  watermarkConfig Json?
  fields      TemplateField[]
  documents   Document[]
  createdBy   String
  creator     User                  @relation("TemplateVersionCreator", fields: [createdBy], references: [id])
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([templateId, version])
  @@index([templateId])
  @@map("template_versions")
}

enum TemplateEditorMode {
  DOCUMENT
  PDF_OVERLAY
}

// spec 3.1: field types
enum FieldType {
  TEXT
  DATE
  SEAL              // Company seal field
  SIGNATURE         // Personal signature field
  PERFORATION_SEAL  // Perforation seal (spec 20.6 reserved, not in phase 1)
}

model TemplateField {
  id                String          @id @default(cuid())
  templateVersionId String
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  type              FieldType
  label             String
  // spec 3.1: geometry { page, x, y, width, height, rotation } in a Json column
  // Units: PDF points, origin bottom-left; PERFORATION_SEAL may span pages
  // Read/write must go through the zod schema (src/schemas/coordinates.ts)
  coordinates       Json
  required          Boolean         @default(false)
  defaultValue      String?
  // spec 3.1: validation rules in Json, read/write via zod
  validationRules   Json?
  // spec 5: font config
  fontSize          Int             @default(12)
  fontFamily        String?
  // spec 20.2: multilingual labels (Json keyed by locale)
  labelI18n         Json?
  sortOrder         Int             @default(0)

  signatures        Signature[]

  @@index([templateVersionId])
  @@map("template_fields")
}

// ============ Seals (spec 0/4: Seal = company stamp) ============

enum SealStyle {
  ROUND_CHINESE        // Round official seal (CN)
  TEXT_INTERNATIONAL   // Text company seal (intl)
  NONE                 // No seal (spec 20.6: driven by template fields)
}

model Seal {
  id         String    @id @default(cuid())
  name       String
  style      SealStyle @default(ROUND_CHINESE)
  // spec 12: original seal image is backend-only, never sent to the client
  storageKey String    @unique
  sha256     String
  // Size (PDF points)
  width      Float
  height     Float
  enabled    Boolean   @default(true)
  createdBy  String
  creator    User      @relation("SealCreator", fields: [createdBy], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  signatures Signature[]

  @@map("seals")
}

// ============ Documents and versions (spec 3.2: never overwrite) ============

enum DocumentVersionStage {
  FILLED       // Form values filled
  WATERMARKED  // Watermark applied
  SEALED       // Company seal applied
  SIGNED       // Personal signature (incl. phase-2 crypto signatures)
}

model Document {
  id                String           @id @default(cuid())
  templateVersionId String
  templateVersion   TemplateVersion  @relation(fields: [templateVersionId], references: [id])
  title             String
  category          TemplateCategory
  // Business field values used to fill the PDF, validated by zod
  fieldValues       Json?
  createdBy         String
  creator           User             @relation("DocumentCreator", fields: [createdBy], references: [id])
  versions          DocumentVersion[]
  signingTask       SigningTask?
  // spec 9: legal hold
  legalHold         Boolean          @default(false)
  legalHoldReason   String?
  legalHoldUntil    DateTime?
  // spec 9: soft-deleted by retention-scan when due
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([templateVersionId])
  @@map("documents")
}

model DocumentVersion {
  id          String                @id @default(cuid())
  documentId  String
  document    Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  stage       DocumentVersionStage
  // spec 2: StorageProvider key includes version; overwrite is forbidden
  // Shape: documents/{docId}/v{version}-{stage}.pdf
  storageKey  String                @unique
  sha256      String
  createdBy   String
  creator     User                  @relation("DocumentVersionCreator", fields: [createdBy], references: [id])
  // spec 3.2: read-only lock after crypto sign (phase 2; phase 1 records the field only)
  lockedAt    DateTime?
  createdAt   DateTime              @default(now())

  signatures  Signature[]

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

// ============ Signing tasks (spec 3.3: two independent state machines) ============

enum SigningFlowType {
  SEQUENTIAL  // Sequential
  PARALLEL    // Parallel
}

// State machine 1: ApprovalStatus
enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

// State machine 2: SigningStatus
enum SigningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DECLINED
  EXPIRED
  REVOKED
}

enum SignerStatus {
  PENDING
  VIEWED
  SIGNED
  DECLINED
}

enum SignerRole {
  APPROVER            // Approver
  COMPANY_SEAL        // Company-seal signer
  PERSONAL_SIGNATURE  // Personal signer
}

model SigningTask {
  id              String        @id @default(cuid())
  documentId      String        @unique
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title           String
  flowType        SigningFlowType @default(SEQUENTIAL)

  // spec 3.3: two independent state machines
  approvalStatus  ApprovalStatus @default(DRAFT)
  signingStatus   SigningStatus  @default(NOT_STARTED)

  expiresAt       DateTime?
  revokedReason   String?
  revokedAt       DateTime?

  createdBy       String
  creator         User          @relation("TaskCreator", fields: [createdBy], references: [id])

  signers         Signer[]
  approvalFlow    ApprovalFlow?
  approvalRecords ApprovalRecord[]
  signatures      Signature[]
  notifications   NotificationLog[]
  webhookDeliveries WebhookDelivery[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([approvalStatus])
  @@index([signingStatus])
  @@map("signing_tasks")
}

model Signer {
  id                String       @id @default(cuid())
  taskId            String
  task              SigningTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Internal signer (spec 6: HR / department lead / employee)
  userId            String?
  user              User?        @relation(fields: [userId], references: [id])
  // External signer (spec 4: no account)
  externalFullName  String?
  externalEmail     String?
  externalPhoneE164 String?

  signRole          SignerRole
  order             Int          @default(1) // Sequential order, starting at 1
  status            SignerStatus @default(PENDING)

  // spec 4: external signing token (hash only)
  signingTokens     SigningToken[]

  viewedAt          DateTime?
  signedAt          DateTime?
  declinedAt        DateTime?
  declinedReason    String?

  signatures        Signature[]

  @@index([taskId])
  @@map("signers")
}

// spec 4: SigningToken stores hash only (not plaintext); expiring and revocable
// shortCode is the public URL face (/s/{shortCode}); tokenHash = sha256(shortCode)
model SigningToken {
  id               String   @id @default(cuid())
  signerId         String
  signer           Signer   @relation(fields: [signerId], references: [id], onDelete: Cascade)
  // Store sha256(plaintext) only, never plaintext
  tokenHash        String   @unique
  // Public short link code (also the plaintext hashed into tokenHash for new tokens)
  shortCode        String?  @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  usedAt           DateTime?
  // spec 4: always record IP and UA
  issuedIp          String?
  issuedUserAgent   String?

  createdAt         DateTime @default(now())

  @@index([signerId])
  @@map("signing_tokens")
}

// Invite / password-reset tokens (plaintext only in email once; DB stores hash)
enum AuthCredentialPurpose {
  INVITE
  PASSWORD_RESET
}

model AuthCredentialToken {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthCredentialPurpose
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, purpose])
  @@map("auth_credential_tokens")
}

// ============ Approval flow (deprecated: prefer Signer APPROVER + ApprovalPolicy) ============

model ApprovalFlow {
  id                  String       @id @default(cuid())
  taskId              String       @unique
  task                SigningTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Ordered approver IDs; approvers also exist as Signer rows with signRole=APPROVER
  approverIds         String[]
  currentApproverIndex Int         @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("approval_flows")
}

model ApprovalRecord {
  id         String         @id @default(cuid())
  taskId     String
  task       SigningTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  approverId String
  approver   User           @relation(fields: [approverId], references: [id])
  // Actions: APPROVE / REJECT / WITHDRAW
  action     String
  fromStatus ApprovalStatus
  toStatus   ApprovalStatus
  comment    String?
  ip         String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([taskId])
  @@map("approval_records")
}

// ============ Signature records (spec 0: Signature = personal signing) ============

enum SignatureMethod {
  IMAGE_SEAL   // Phase 1: image seal
  HANDWRITE    // Phase 1: handwritten signature image
  // Phase 2 reserved (enum only, not implemented in phase 1)
  PADES
  GM_SM2
}

model Signature {
  id                String           @id @default(cuid())
  taskId            String
  task              SigningTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  signerId          String
  signer            Signer           @relation(fields: [signerId], references: [id])
  // Actor (external signers have no account)
  operatorId        String?
  operator          User?            @relation("SignatureOperator", fields: [operatorId], references: [id])

  method            SignatureMethod
  // Phase 1: signature image storageKey; phase 2: signature payload
  storageKey        String?
  sealId            String?
  seal              Seal?            @relation(fields: [sealId], references: [id])

  // Target template field
  fieldId           String?
  field             TemplateField?   @relation(fields: [fieldId], references: [id])

  // spec 3.2: each seal/sign creates a new DocumentVersion
  documentVersionId String?
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id])

  // spec 2: SignatureProvider.verify result (Json, validated by zod)
  verificationResult Json?

  ip                String?
  userAgent         String?
  createdAt         DateTime         @default(now())

  @@index([taskId])
  @@index([signerId])
  @@map("signatures")
}

// ============ Audit log (spec 8: hash chain + append-only) ============
// Database forbids UPDATE/DELETE (enforced by migration SQL triggers)
// Hash: hash = sha256(prevHash + canonical JSON(canonical_fields))
// spec 20.8: store "action code + params", never localized text

model AuditLog {
  id              String   @id @default(cuid())
  // Hash chain: previous record hash; first record is null
  prevHash        String?
  // This record hash = sha256(prevHash + canonical_json)
  hash            String   @unique
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  // Action code (e.g. "task.sign", "template.publish")
  action          String
  targetType      String
  targetId        String?
  // Result: success / failure
  result          String   @default("success")
  // spec 8: related document sha256
  documentSha256  String?
  ip              String?
  userAgent       String?
  // Action params (Json, validated by zod; no localized text)
  detail          Json?
  createdAt       DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============ Data retention (spec 9) ============

enum RetentionAction {
  SOFT_DELETE
  HARD_DELETE
  NOTIFY_OWNER
}

model RetentionPolicy {
  id              String           @id @default(cuid())
  name            String
  category        TemplateCategory
  // Retention years
  retentionYears  Int
  action          RetentionAction  @default(SOFT_DELETE)
  enabled         Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // One policy per category
  @@unique([category])
  @@map("retention_policies")
}

model AppSettings {
  id                String   @id @default("default")
  watermarkText     String
  /// IMAGE_SEAL | PADES | GM_SM2 — cryptographic method after visual stamp
  signatureMethod   String   @default("IMAGE_SEAL")
  /// Days before expiry to send reminder (0 = overdue only)
  remindDaysBefore  Int      @default(3)
  /// JSON string array: EMAIL, WECOM, DINGTALK, LARK
  notifyChannels    String   @default("[\"EMAIL\"]")
  /// Optional PEM certificate (PAdES demo); prefer env PADES_CERT_PEM
  padesCertPem      String?
  /// Optional PEM private key (PAdES demo); prefer env PADES_KEY_PEM
  padesKeyPem       String?
  /// Demo SM2 keypair JSON { publicKey, privateKey }
  sm2KeyJson        String?
  updatedAt         DateTime @updatedAt

  @@map("app_settings")
}

// ============ API Key & Webhook（spec 10）============

model ApiKey {
  id                String    @id @default(cuid())
  name              String
  // spec 12: store hashes only
  keyHash           String    @unique
  // For identification (first 8 chars plaintext)
  keyPrefix         String
  createdBy         String
  creator           User      @relation(fields: [createdBy], references: [id])
  // Permission scope
  scopes            String[]  @default([])
  rateLimitPerMinute Int?
  lastUsedAt        DateTime?
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@map("api_keys")
}

model Webhook {
  id          String             @id @default(cuid())
  name        String
  url         String
  // HMAC signing secret (hash only)
  secretHash  String
  // For identification
  secretPrefix String
  // Subscribed events (e.g. task.created, approval.result, signing.completed)
  events      String[]           @default([])
  enabled     Boolean            @default(true)
  createdBy   String
  creator     User               @relation(fields: [createdBy], references: [id])
  deliveries  WebhookDelivery[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("webhooks")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

model WebhookDelivery {
  id             String               @id @default(cuid())
  webhookId      String
  webhook        Webhook              @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  taskId         String?
  task           SigningTask?         @relation(fields: [taskId], references: [id])
  event          String
  // payload validated by zod
  payload        Json
  // HMAC signature (for delivery)
  signature      String
  responseStatus Int?
  responseError  String?
  attemptCount   Int                  @default(0)
  status         WebhookDeliveryStatus @default(PENDING)
  deliveredAt    DateTime?
  nextRetryAt    DateTime?
  createdAt      DateTime             @default(now())

  @@index([webhookId])
  @@map("webhook_deliveries")
}

// ============ Notifications (spec 2 Notifier / 20: templates per locale) ============

enum NotificationChannel {
  EMAIL     // Required in phase 1
  SMS       // Phase 2 OTP / invite
  WECOM     // WeCom (optional adapter)
  DINGTALK  // DingTalk (optional adapter)
  LARK      // Lark / Feishu (optional adapter)
  SLACK     // Slack Incoming Webhook
  TEAMS     // Microsoft Teams Incoming Webhook
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // Channel not configured
}

model NotificationLog {
  id               String             @id @default(cuid())
  taskId           String?
  task             SigningTask?       @relation(fields: [taskId], references: [id])
  // Recipient
  recipientUserId  String?
  recipientUser    User?              @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  recipientEmail   String?
  recipientPhone   String?
  channel          NotificationChannel @default(EMAIL)
  // spec 20: templates exist per locale; this stores the key only
  templateKey      String
  // Template params (Json, ICU MessageFormat variables)
  templateParams   Json?
  // Actual sent content (for audit)
  subject          String?
  body             String?
  status           NotificationStatus @default(PENDING)
  error            String?
  // Retry info
  attemptCount     Int                @default(0)
  sentAt           DateTime?
  createdAt        DateTime           @default(now())

  @@index([taskId])
  @@map("notification_logs")
}

// spec 15/20: NotificationTemplate stored per locale
model NotificationTemplate {
  id            String             @id @default(cuid())
  key           String             // e.g. "signing.invitation", "approval.request"
  channel       NotificationChannel
  locale        UserLocale
  // ICU MessageFormat（spec 20.1）
  subject       String
  body          String
  defaultParams Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Unique per (key, channel, locale)
  @@unique([key, channel, locale])
  @@map("notification_templates")
}

// ============ Identity verification (spec 2 IdentityVerifier / 4 email codes) ============

enum IdentityVerificationType {
  EMAIL_CODE  // Implemented in phase 1
  SMS_OTP     // Phase 2
  // Phase 2 reserved (enum only — plugins throw until wired)
  FACE
  REAL_NAME
  KBA
  ID_DOCUMENT
}

enum IdentityVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

model IdentityVerification {
  id                String                     @id @default(cuid())
  type              IdentityVerificationType   @default(EMAIL_CODE)
  // Verification target (email, phone, etc.)
  target            String
  // spec 4: verification-code hash only
  codeHash          String
  // spec 4: attempt limits and cooldown
  attemptCount      Int                        @default(0)
  maxAttempts       Int                        @default(5)
  // Related signing token (external signer verification)
  signingTokenId    String?
  status            IdentityVerificationStatus @default(PENDING)
  verifiedAt        DateTime?
  expiresAt         DateTime
  // spec 4：IP/UA
  requestIp         String?
  requestUserAgent  String?
  createdAt          DateTime                  @default(now())

  @@index([target])
  @@map("identity_verifications")
}

// =================================================================
// Envelope domain (DocuSign-parity) — coexists with SigningTask
// =================================================================

enum EnvelopeStatus {
  created
  sent
  delivered
  signed
  completed
  declined
  voided
  expired
  corrected
}

enum RecipientType {
  signer
  cc
  agent
  editor
  certifiedDelivery
  inPersonSigner
  notary
  witness
  carbonCopy
  intermediary
}

enum EnvelopeRecipientStatus {
  created
  sent
  delivered
  signed
  declined
  completed
  faxpending
  autoresponded
}

enum TabType {
  signHere
  initialHere
  dateSigned
  text
  fullName
  emailAddress
  checkbox
  radioGroup
  formula
  attachment
  payment
  company
  title
  note
}

/// Multi-tenant account (Phase 4; default single account seeded).
model Account {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  members   AccountMember[]
  envelopes Envelope[]
  brands    Brand[]

  @@map("accounts")
}

model AccountMember {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("sender") // admin | sender | viewer
  createdAt DateTime @default(now())

  @@unique([accountId, userId])
  @@map("account_members")
}

model Brand {
  id           String  @id @default(cuid())
  accountId    String
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  brandName    String
  primaryColor String  @default("#1a1a1a")
  logoKey      String?

  @@map("brands")
}

model Envelope {
  id           String         @id @default(cuid())
  accountId    String?
  account      Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status       EnvelopeStatus @default(created)
  subject      String
  emailBlurb   String?
  sentAt       DateTime?
  completedAt  DateTime?
  voidedAt     DateTime?
  voidReason   String?
  expiresAt    DateTime?
  /// Bridge to legacy SigningTask during migration
  legacyTaskId String?        @unique
  createdBy    String
  creator      User           @relation("EnvelopeCreator", fields: [createdBy], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  documents  EnvelopeDocument[]
  recipients EnvelopeRecipient[]
  comments   EnvelopeComment[]
  events     EnvelopeEvent[]
  tabs       EnvelopeTab[]

  @@index([status])
  @@index([createdBy])
  @@index([accountId])
  @@map("envelopes")
}

model EnvelopeDocument {
  id            String   @id @default(cuid())
  envelopeId    String
  envelope      Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  documentOrder Int      @default(1)
  name          String
  storageKey    String?
  sha256        String?
  pageCount     Int      @default(1)
  createdAt     DateTime @default(now())

  tabs EnvelopeTab[]

  @@index([envelopeId])
  @@map("envelope_documents")
}

model EnvelopeRecipient {
  id              String                  @id @default(cuid())
  envelopeId      String
  envelope        Envelope                @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipientType   RecipientType           @default(signer)
  routingOrder    Int                     @default(1)
  name            String
  email           String
  /// E.164 phone for SMS delivery / OTP (Phase 2)
  phoneE164       String?
  /// email | sms | both (default email)
  deliveryChannel String                  @default("email")
  /// none | email_otp | sms_otp | kba | id_document | face
  idvMethod       String                  @default("none")
  /// pending | verified | skipped
  idvStatus       String                  @default("skipped")
  /// For inPersonSigner: optional host user email / recipient id note
  hostUserId      String?
  /// For witness: the recipient being witnessed
  witnessForId    String?
  status          EnvelopeRecipientStatus @default(created)
  userId          String?
  accessTokenHash String?
  signedAt        DateTime?
  declinedAt      DateTime?
  declineReason   String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tabs EnvelopeTab[]

  @@index([envelopeId])
  @@index([email])
  @@map("envelope_recipients")
}

model EnvelopeTab {
  id                 String             @id @default(cuid())
  envelopeId         String
  envelope           Envelope           @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  envelopeDocumentId String?
  document           EnvelopeDocument?  @relation(fields: [envelopeDocumentId], references: [id], onDelete: Cascade)
  recipientId        String?
  recipient          EnvelopeRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  tabType            TabType
  /// { page, x, y, width, height, rotation }
  coordinates        Json
  required           Boolean            @default(true)
  value              String?
  /// Conditional show rules (zod later)
  conditional        Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([envelopeId])
  @@index([recipientId])
  @@map("envelope_tabs")
}

model EnvelopeComment {
  id         String   @id @default(cuid())
  envelopeId String
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation("EnvelopeCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  documentId String?
  page       Int?
  createdAt  DateTime @default(now())

  @@index([envelopeId])
  @@map("envelope_comments")
}

model EnvelopeEvent {
  id         String   @id @default(cuid())
  envelopeId String
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  action     String
  actorEmail String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([envelopeId])
  @@map("envelope_events")
}

/// PowerForm stub table
model PowerForm {
  id         String   @id @default(cuid())
  name       String
  templateId String
  urlSlug    String   @unique
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("power_forms")
}

/// Clickwrap agreement (Phase 3)
model Clickwrap {
  id            String               @id @default(cuid())
  name          String
  displayName   String?
  status        String               @default("active") // active | inactive | draft
  bodyHtml      String?
  version       Int                  @default(1)
  requireScroll Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  acceptances   ClickwrapAcceptance[]

  @@map("clickwraps")
}

model ClickwrapAcceptance {
  id           String    @id @default(cuid())
  clickwrapId  String
  clickwrap    Clickwrap @relation(fields: [clickwrapId], references: [id], onDelete: Cascade)
  acceptorName String?
  acceptorEmail String
  ip           String?
  userAgent    String?
  documentHash String?
  acceptedAt   DateTime  @default(now())

  @@index([clickwrapId])
  @@index([acceptorEmail])
  @@map("clickwrap_acceptances")
}

/// Rooms (Phase 3 — transaction rooms)
model Room {
  id          String         @id @default(cuid())
  name        String
  status      String         @default("active") // active | closed
  description String?
  ownerId     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  members     RoomMember[]
  documents   RoomDocument[]

  @@map("rooms")
}

model RoomMember {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name      String
  email     String
  role      String   @default("viewer") // owner | editor | viewer
  createdAt DateTime @default(now())

  @@index([roomId])
  @@map("room_members")
}

model RoomDocument {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name       String
  storageKey String?
  envelopeId String?
  createdAt  DateTime @default(now())

  @@index([roomId])
  @@map("room_documents")
}

/// CLM agreement (Phase 3)
model ClmAgreement {
  id           String    @id @default(cuid())
  name         String
  status       String    @default("draft") // draft | in_review | active | expired | terminated
  counterparty String?
  envelopeId   String?
  effectiveOn  DateTime?
  expiresOn    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("clm_agreements")
}

/// Notary transaction (Phase 3)
model NotaryTransaction {
  id           String    @id @default(cuid())
  status       String    @default("created") // created | scheduled | in_session | completed | cancelled
  envelopeId   String?
  notaryName   String?
  jurisdiction String?
  scheduledAt  DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("notary_transactions")
}

/// Bulk send batch (DocuSign BulkSend)
model BulkSendBatch {
  id         String   @id @default(cuid())
  templateId String
  status     String   @default("queued") // queued | processing | completed | failed
  total      Int      @default(0)
  succeeded  Int      @default(0)
  failed     Int      @default(0)
  createdBy  String
  /// [{ email, name, envelopeId?, error? }]
  results    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdBy])
  @@map("bulk_send_batches")
}
